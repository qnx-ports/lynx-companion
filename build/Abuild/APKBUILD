# Alpine-Contributor: Sören Tempel <soeren+alpine@soeren-tempel.net>
# Alpine-Contributor: Sheila Aman <sheila@vulpine.house>
# Alpine-Maintainer: Sheila Aman <sheila@vulpine.house>
# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=lynx
pkgver=2.9.2
_relver=${pkgver/_p/rel.}
pkgrel=0
pkgdesc="Cross-platform text-based browser"
url="https://lynx.invisible-island.net/"
arch="all"
license="GPL-2.0-only"
depends="libcrypto3 libintl zlib-ng glib ncurses"
makedepends="openssl-dev>3 gettext zlib-ng-dev glib-dev perl ncurses-dev"
subpackages="$pkgname-doc"
source="https://invisible-mirror.net/archives/lynx/tarballs/lynx$_relver.tar.bz2
        atexit.patch
	fix-qnx.patch
"
builddir="$srcdir"/$pkgname$_relver

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--localstatedir=/var \
		--enable-ipv6 \
		--with-ssl \
		--enable-default-colors \
		--with-screen=ncursesw \
		--with-zlib \
		--disable-full-paths \
		--enable-externs \
		--disable-nls \
		--disable-find-leaks
	make helpdir=/usr/share/doc/lynx/help \
		docdir=/usr/share/doc/lynx
}

check() {
	./lynx -version
}

package() {
	make DESTDIR="$pkgdir" install install-help install-doc \
		helpdir=/usr/share/doc/lynx/help \
		docdir=/usr/share/doc/lynx
}


